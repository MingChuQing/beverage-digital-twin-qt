      "label": "空瓶进料",
      "duration": 4,
      "active": [
        "Infeed",
        "Gripper",
        "ContainerSensor"
      ],
      "note": "输送空瓶进入检测区域",
      "route": "empty"
    },
    {
      "label": "瓶位检测",
      "duration": 3,
      "active": [
        "BottleSensor",
        "ContainerSensor"
      ],
      "note": "等待瓶子到位后定位",
      "route": "empty"
    },
    {
      "label": "瓶内冲洗",
      "duration": 5,
      "active": [
        "RinseValve",
        "PressureSensor"
      ],
      "note": "冲洗流路高亮，模拟压力采样",
      "route": "rinse"
    },
    {
      "label": "灌装定位",
      "duration": 4,
      "active": [
        "X",
        "Y1",
        "Y2",
        "Z"
      ],
      "note": "按演示坐标移动至灌装工位",
      "route": "fill"
    },
    {
      "label": "灌装",
      "duration": 8,
      "active": [
        "${fill_device}",
        "FlowMeter",
        "LevelSensor",
        "PressureSensor"
      ],
      "note": "选定口味的共用灌装头，容量和设定时长读取当前配方",
      "route": "fill"
    },
    {
      "label": "液位复检",
      "duration": 3,
      "active": [
        "LevelSensor"
      ],
      "note": "模拟检测灌装后的液位到位信号",
      "route": "fill"
    },
    {
      "label": "封口",
      "duration": 5,
      "active": [
        "Closure",
        "CapFeeder",
        "Relay",
        "Torque"
      ],
      "note": "Relay 旋盖输出与 Torque 测量关联",
      "route": "closure"
    },
    {
      "label": "喷码贴标",
      "duration": 4,
      "active": [
        "Relay",
        "BottleSensor"
      ],
      "note": "Relay 喷码/贴标输出与瓶位检测关联",
      "route": "code"
    },
    {
      "label": "成品出料",
      "duration": 4,
      "active": [
        "Gripper",
        "Outfeed",
        "BottleSensor"
      ],
      "note": "已灌装并封盖的容器完成出料",
      "route": "finished"
    },
    {
      "label": "CIP 清洗",
      "duration": 5,
      "active": [
        "CIPValve",
        "RinseValve",
        "PressureSensor",
